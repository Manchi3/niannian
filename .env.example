# ====================================
# DeepSeek API Configuration
# ====================================
# Your DeepSeek API key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your-api-key-here

# Model name (deepseek-chat for text conversation)
DEEPSEEK_MODEL=deepseek-chat

# Base URL (DeepSeek is OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ====================================
# MiMo API Configuration (Image Understanding)
# ====================================
# Your MiMo API key (image understanding model)
MIMO_API_KEY=your_mimo_api_key

# MiMo model name
MIMO_MODEL=mimo-v2.5

# MiMo base URL
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
